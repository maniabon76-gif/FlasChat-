# ═══════════════════════════════════════════════
# FlasChat · Variables de entorno
# Copia este archivo como ".env" y rellena tus datos
# ═══════════════════════════════════════════════

# Credenciales Nauta
NAUTA_USER=tu_usuario@nauta.cu
NAUTA_PASS=tu_contraseña_de_nauta

# Servidores Nauta (no cambiar salvo que ETECSA lo actualice)
SMTP_HOST=smtp.nauta.cu
SMTP_PORT=25
IMAP_HOST=imap.nauta.cu
IMAP_PORT=143

# Puerto del servidor local
PORT=3000
